{
  "name": "edu-sl",
  "version": "1.0.0",
  "description": "Trilingual (English, සිංහල, தமிழ்) Sri Lanka universities, higher education institutes, and faculties dataset for TypeScript and JavaScript.",
  "author": "Mahesh Abeykoon",
  "license": "MIT",
  "homepage": "https://github.com/mahesh-abeykoon/edu-sl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahesh-abeykoon/edu-sl.git"
  },
  "bugs": {
    "url": "https://github.com/mahesh-abeykoon/edu-sl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./universities": {
      "import": {
        "types": "./dist/universities.d.ts",
        "default": "./dist/universities.js"
      },
      "require": {
        "types": "./dist/universities.d.cts",
        "default": "./dist/universities.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "sri-lanka",
    "universities",
    "higher-education",
    "ugc",
    "faculties",
    "degrees",
    "institutes",
    "colombo",
    "peradeniya",
    "moratuwa"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "tsup": "^8.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
